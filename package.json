{
  "name": "sub-box",
  "version": "0.2.0",
  "private": true,
  "cloudflare": {
    "bindings": {
      "ADMIN_PASSWORD": {
        "description": "管理员登录密码"
      },
      "JWT_SECRET": {
        "description": "用于签发登录会话的密钥，可用 openssl rand -base64 32 生成"
      }
    }
  },
  "scripts": {
    "db:up": "bun with-env drizzle-kit up",
    "db:generate": "bun with-env drizzle-kit generate",
    "db:push": "bun with-env drizzle-kit push",
    "db:push:local": "bun with-env bun with-local-db drizzle-kit push --config drizzle.local.config.ts",
    "db:migrate": "bun with-env drizzle-kit migrate",
    "db:migrate:local": "bun with-env bun with-local-db drizzle-kit migrate --config drizzle.local.config.ts",
    "db:check": "bun with-env drizzle-kit check",
    "db:studio": "bun with-env drizzle-kit studio",
    "db:studio:local": "bun with-env bun with-local-db drizzle-kit studio --config drizzle.local.config.ts",
    "d1:migrate:local": "wrangler d1 migrations apply DB --local",
    "d1:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "dev": "vite dev --port 3000",
    "dev:next": "bun with-env next dev",
    "build": "bun run openapi:generate && vite build",
    "build:next": "bun with-env next build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "tc": "bun with-env tsc --noEmit",
    "preview": "vite build && wrangler dev --config dist/server/wrangler.json",
    "deploy": "vinext-cloudflare deploy --config dist/server/wrangler.json",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv --include-runtime false cloudflare-env.d.ts",
    "with-env": "dotenv -e .dev.vars --",
    "with-local-db": "cross-env LOCAL_DB_PATH=$(find .wrangler/state/v3/d1/miniflare-D1DatabaseObject -type f -name '*.sqlite' -print -quit)",
    "dev:vinext": "vite dev --port 3000",
    "build:vinext": "bun run openapi:generate && vite build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json",
    "openapi:generate": "bun scripts/generate-openapi.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.2.2",
    "@libsql/client": "^0.15.15",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-aspect-ratio": "^1.1.8",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-menubar": "^1.1.16",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-query-devtools": "^5.104.1",
    "@tanstack/react-table": "^8.21.3",
    "@trpc/client": "^11.19.0",
    "@trpc/react-query": "^11.19.0",
    "@trpc/server": "^11.19.0",
    "@vinext/cloudflare": "^1.1.0",
    "autoprefixer": "^10.4.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "dotenv-cli": "^11.0.0",
    "drizzle-orm": "^0.45.4",
    "embla-carousel-react": "8.6.0",
    "input-otp": "1.4.2",
    "jose": "^5.10.0",
    "lucide-react": "^0.544.0",
    "ms": "^2.1.3",
    "next": "16.4.0",
    "next-themes": "^0.4.6",
    "openapi-fetch": "^0.15.0",
    "react": "^19.3.0",
    "react-day-picker": "8.10.1",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.65.0",
    "react-resizable-panels": "^2.1.9",
    "react-server-dom-webpack": "^19.3.0",
    "recharts": "2.15.4",
    "server-only": "0.0.1",
    "sonner": "^1.7.4",
    "superjson": "^2.2.6",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^0.9.9",
    "vinext": "^1.1.0",
    "yaml": "^2.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@cloudflare/vite-plugin": "1",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@trpc/openapi": "11.19.0-alpha",
    "@types/ms": "^2.1.0",
    "@types/node": "^22.18.11",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-rsc": "^0.5.36",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.11",
    "openapi-typescript": "^7.10.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "wrangler": "^4.45.0"
  },
  "packageManager": "bun@1.3.13",
  "type": "module"
}
